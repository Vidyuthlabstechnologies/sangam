rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles are private to the Firebase Auth user who owns the document.
    // Anything else is denied, including a signed-in user reading someone else's row.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
