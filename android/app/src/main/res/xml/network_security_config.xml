<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy: HTTPS only, system certificate authorities only.
  Debug builds replace this file with src/debug/res/xml/network_security_config.xml
  so a local backend over HTTP (10.0.2.2) still works during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
