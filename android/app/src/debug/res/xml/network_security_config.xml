<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Lives in src/debug/ so release builds never see it.

  Debug builds may talk to a local backend over cleartext HTTP: the emulator
  alias 10.0.2.2, or a computer's LAN address from Server Connection Settings.
  Release builds do not include this file and stay HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
