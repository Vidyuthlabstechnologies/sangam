# Sangam Backend Configuration
DATABASE_URL=postgresql+asyncpg://sangam:sangam@localhost:5432/sangam
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
TEMPORAL_HOST=localhost:7233

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=generate-a-random-64-char-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS - comma-separated origins
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Sarvam AI
SARVAM_API_KEY=

# Voice agent callback webhook: a long random value. Set the SAME value as a
# Secret in Sarvam and send it as the X-Webhook-Secret header. Unset = the
# webhook rejects every request.
AGENT_WEBHOOK_SECRET=

# Optional: forward each callback to a Google Sheet (Apps Script web app) ...
CALLBACK_SHEET_WEBHOOK_URL=
CALLBACK_SHEET_WEBHOOK_SECRET=
# ... and message staff on WhatsApp (Cloud API, approved template, 5 placeholders).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_STAFF_NUMBERS=
WHATSAPP_TEMPLATE_NAME=surya_new_callback
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=capabilities

# Postgres pool. Defaults are fine for a small deployment.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

# SMTP. Leave SMTP_HOST empty to skip mail. No SendGrid/Mailgun SDK.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@sangam.ai

# Optional MinIO/S3. Leave the endpoint empty to keep the current storage path.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional local LLM (OpenAI-compatible). Off unless LLM_BASE_URL is set.
# Ignored when SARVAM_API_KEY is set. Do not download model weights into this repo.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
