# Sangam Backend Configuration
DATABASE_URL=postgresql+asyncpg://sangam:sangam@localhost:5432/sangam
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
TEMPORAL_HOST=localhost:7233

# Security - CHANGE THESE IN PRODUCTION
# Local JWTs are not the account system. Zitadel issues access tokens.
JWT_SECRET=generate-a-random-64-char-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Self-hosted Zitadel (`docker compose -f docker-compose.zitadel.yml up -d`). Leave the issuer
# empty to run without calling identity. Do not point this at Zitadel Cloud.
# Firebase Authentication (Android sign-in: Google and email/password).
# The Firebase project id from android/app/google-services.json. The backend
# checks Firebase ID tokens against Google's public keys; no secret is needed.
FIREBASE_PROJECT_ID=sangamitra-ai
# Set true to refuse email/password accounts until the address is verified.
FIREBASE_REQUIRE_VERIFIED_EMAIL=false

# RevenueCat webhook (Google Play purchases credit wallets). Make up a long
# random string; put the same value in RevenueCat -> Integrations -> Webhooks
# -> Authorization header. Empty means the webhook refuses every call.
REVENUECAT_WEBHOOK_AUTH=
# true while testing with license testers; false in production so sandbox
# purchases never credit real wallets.
REVENUECAT_ACCEPT_SANDBOX=true

# ZITADEL_MASTERKEY is required by the identity profile and must be 32 bytes.
# The value below is a placeholder, not a key to copy into production manifests.
ZITADEL_MASTERKEY=replace-this-32-byte-masterkey!!
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_ANDROID_CLIENT_ID=
ZITADEL_PROJECT_ID=
# Optional. Defaults to {ZITADEL_ISSUER}/oauth/v2/keys. From a backend
# container, set this to http://zitadel-proxy/oauth/v2/keys while the issuer
# stays http://localhost:8080 (the URL inside the token).
ZITADEL_JWKS_URL=

# Web (Vite). Public PKCE client. No client secret.
VITE_ZITADEL_ISSUER=http://localhost:8080
VITE_ZITADEL_CLIENT_ID=

# CORS - comma-separated origins
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Sarvam AI
SARVAM_API_KEY=

# Voice agent callback webhook: a long random value. Set the SAME value as a
# Secret in Sarvam and send it as the X-Webhook-Secret header. Unset = the
# webhook rejects every request.
AGENT_WEBHOOK_SECRET=

# Optional: forward each callback to a Google Sheet (Apps Script web app) ...
CALLBACK_SHEET_WEBHOOK_URL=
CALLBACK_SHEET_WEBHOOK_SECRET=
# ... and message staff on WhatsApp (Cloud API, approved template, 5 placeholders).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_STAFF_NUMBERS=
WHATSAPP_TEMPLATE_NAME=surya_new_callback
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=capabilities

# Postgres pool. Defaults are fine for a small deployment.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

# SMTP. Leave SMTP_HOST empty to skip mail. No SendGrid/Mailgun SDK.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@sangam.ai

# Optional MinIO/S3. Leave the endpoint empty to keep the current storage path.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional local LLM (OpenAI-compatible). Off unless LLM_BASE_URL is set.
# Ignored when SARVAM_API_KEY is set. Do not download model weights into this repo.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
