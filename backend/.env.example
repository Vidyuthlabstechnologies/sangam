APP_NAME=Sangam
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://sangam:sangam@localhost:5432/sangam
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=sangam

SARVAM_API_KEY=

QDRANT_URL=http://localhost:6333

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Zitadel resource-server settings. Empty issuer means "do not call the network".
# Local identity: docker compose --profile identity up, then set the issuer to
# http://localhost:8080. Create two public PKCE apps (web and Android). Put the
# project id here because Zitadel access tokens often use it as the audience.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_ANDROID_CLIENT_ID=
ZITADEL_PROJECT_ID=
ZITADEL_JWKS_URL=
