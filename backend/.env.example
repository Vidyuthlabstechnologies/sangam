APP_NAME=Sangam
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=postgresql+asyncpg://sangam:sangam@localhost:5432/sangam
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=sangam

SARVAM_API_KEY=

QDRANT_URL=http://localhost:6333

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# SMTP. Empty host skips mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional MinIO/S3. Empty endpoint keeps uploads out of object storage.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional OpenAI-compatible local model. Off unless set. Sarvam wins when its key is set.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

# Firebase Authentication (Android sign-in: Google and email/password).
# The Firebase project id from android/app/google-services.json. The backend
# checks Firebase ID tokens against Google's public keys; no secret is needed.
FIREBASE_PROJECT_ID=sangamitra-ai
# Refuse email/password accounts until the address is verified (the app sends the link).
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# RevenueCat webhook (Google Play purchases credit wallets). Make up a long
# random string; put the same value in RevenueCat -> Integrations -> Webhooks
# -> Authorization header. Empty means the webhook refuses every call.
REVENUECAT_WEBHOOK_AUTH=
# true while testing with license testers; false in production so sandbox
# purchases never credit real wallets.
REVENUECAT_ACCEPT_SANDBOX=true

# Zitadel resource-server settings. Empty issuer means "do not call the network".
# Local identity: docker compose --profile identity up, then set the issuer to
# http://localhost:8080. Create two public PKCE apps (web and Android). Put the
# project id here because Zitadel access tokens often use it as the audience.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_ANDROID_CLIENT_ID=
ZITADEL_PROJECT_ID=
ZITADEL_JWKS_URL=
