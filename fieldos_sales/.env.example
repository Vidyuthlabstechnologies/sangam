# Copy to .env (gitignored) and fill in. Nothing here is a real secret.

# --- Safety switch. Leave 0 until you have approved prospects and checked everything.
FIELDOS_SALES_LIVE=0

# --- AI (cheapest model; daily spend cap in US dollars)
ANTHROPIC_API_KEY=
SALES_MODEL=claude-haiku-5-5
LLM_DAILY_BUDGET_USD=1.00
# Insights dashboard: http://localhost:8090/dashboard?token=DASHBOARD_TOKEN (long random value)
DASHBOARD_TOKEN=
# 1 = AI-summarise each call when it ends (about $0.001 a call)
AUTO_SUMMARISE=1

# --- Voice (Sarvam speech-to-text and text-to-speech)
SARVAM_API_KEY=
SARVAM_SPEAKER=anushka
SARVAM_TTS_MODEL=bulbul:v3
# Voice A/B test: two or more "model/speaker" voices; each new call gets the one with fewer calls.
# The dashboard's "Voice test" table shows which keeps people on the line. Empty = the single voice above.
VOICE_VARIANTS=
# Experimental: stream speech so the first words play sooner (falls back to normal on any error).
SARVAM_TTS_STREAM=0
# The agent introduces itself by this name (and always as an AI). Gender sets Hindi verb forms: f or m.
AGENT_NAME=Priya
AGENT_GENDER=f
# 1.0 is normal speed; 1.05 sounds brisk but clear on a phone line
VOICE_PACE=1.05
# How long the caller must be silent before the agent answers (ms). Lower = snappier, too low = interrupts.
END_OF_TURN_MS=650

# --- Phone calls (Exotel). Promotional calls must come from your registered telemarketing number.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
# Exotel flow (app) that contains the Voicebot applet pointing at wss://YOUR-HOST/exotel/stream?token=VOICE_STREAM_TOKEN
EXOTEL_FLOW_URL=
VOICE_STREAM_TOKEN=
PUBLIC_BASE_URL=

# --- WhatsApp. Gateway: waha (your own number, unofficial) or twilio (official).
WHATSAPP_GATEWAY=waha
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
# WAHA webhook must call http://HOST:8090/wa/waha?token=WA_WEBHOOK_TOKEN
WA_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Your own WhatsApp number (with 91) that gets "a prospect wants a demo / a person" alerts.
OWNER_NOTIFY_NUMBER=

# --- Limits (keep them low: unofficial WhatsApp numbers get banned for bulk sending)
CALLS_PER_DAY=20
WA_NEW_CHATS_PER_DAY=15
WA_MIN_GAP_SECONDS=240
WA_MAX_GAP_SECONDS=540
CONTACT_HOURS_IST=10-19
CONTACT_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
# Calls only on these days (Saturday is wage day on most sites). WhatsApp uses CONTACT_DAYS.
CALL_DAYS=Mon,Tue,Wed,Thu,Fri
# Your own numbers, for `selftest add --phone ...`. Test firms skip contact hours, DND scrub and caps.
TEST_NUMBERS=
DND_MAX_AGE_DAYS=7
